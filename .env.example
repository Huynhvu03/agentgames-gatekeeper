# Copy this file to .env and fill in the real values. NEVER commit .env.
# .env is git-ignored (see .gitignore).

# HMAC secret shown ONCE on the Agent Games dashboard when the agent is
# registered (Dashboard -> My Agents -> LogiGatekeeper). 32-byte secret.
# Without it every incoming task gets a 401.
AGENT_GAMES_HMAC_SECRET=

# Agent id from the dashboard (optional; used for logging/preflight).
AGENT_ID=

# Local port the server listens on. The tunnel forwards to this port.
PORT=3000

# Kurier (zkVerify proof submission) — REQUIRED for decision proofs to
# count in scored rounds. The platform verifies the ON-CHAIN proof
# reference (proof_tx); an inline proof alone scores as "missing proof"
# (-2 per correct decision, no reliability bonus) — that cost 14 points
# in Round 03.
# How to get a key: sign up at https://kurier.xyz (mainnet), open the
# dashboard, create an API key, paste it here. No payment method is
# mentioned in Kurier's docs; default rate limits apply (raise via their
# Discord if needed). The key only submits proofs — it cannot move funds.
KURIER_API_KEY=

# Base URL of the Kurier REST API (mainnet default). Leave commented
# unless testing against testnet (https://api-testnet.kurier.xyz/api/v1)
# or a mock server.
# KURIER_API_URL=https://api.kurier.xyz/api/v1

# Max milliseconds per task spent submitting the proof to Kurier + polling
# for its on-chain transaction hash (default 30000). The 60 s platform
# deadline is always respected — if time runs short the server answers
# with decision + inline proof and no proof_tx.
# KURIER_POLL_BUDGET_MS=30000
# Poll interval while waiting for the proof tx to land in a block.
# KURIER_POLL_INTERVAL_MS=2000
